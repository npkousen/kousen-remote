    "NAV_LEFT": "KEY_F16",
    "SELECT": "KEY_F17",
    "BACK": "KEY_F18",
    "HOME": "KEY_F19",
    "PLAY_PAUSE": "KEY_F20",
    "MUTE": "KEY_F21",
    "VOLUME_UP": "KEY_F22",
    "VOLUME_DOWN": "KEY_F23",
    "POWER": "KEY_F24",
    "SIRI": "KEY_HOME"
  }
}
